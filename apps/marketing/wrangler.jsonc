{
  // Landing page (apex e6code.com) on Workers Static Assets.
  // The Worker canonicalizes www; path redirects and headers stay in assets.
  // Custom domains provision DNS and certificates when the zone is Active.
  // www.e6code.com is attached so the host redirect in src/worker.mjs can
  // run; a custom domain matches one hostname. Unknown paths serve dist/404.html.
  "name": "e6code-marketing",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true,
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  "routes": [
    { "pattern": "e6code.com", "custom_domain": true },
    { "pattern": "www.e6code.com", "custom_domain": true },
  ],
  "observability": {
    "logs": {
      "enabled": true,
    },
  },
}
