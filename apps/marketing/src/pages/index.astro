---
import Agents from "../components/landing/Agents.astro";
import Calm from "../components/landing/Calm.astro";
import FinalCall from "../components/landing/FinalCall.astro";
import Hero from "../components/landing/Hero.astro";
import HowItWorks from "../components/landing/HowItWorks.astro";
import Product from "../components/landing/Product.astro";
import RemoteOpen from "../components/landing/RemoteOpen.astro";
import Review from "../components/landing/Review.astro";
import Layout from "../layouts/Layout.astro";
import { fetchLatestReleaseAtBuild } from "../lib/releases";
import { DESKTOP_LINK_URL, SITE_DESCRIPTION } from "../lib/site";
import "../styles/landing.css";

const release = await fetchLatestReleaseAtBuild();
const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "E6 Code",
  description: SITE_DESCRIPTION,
  url: Astro.site?.href,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux, iOS, Android",
  downloadUrl: DESKTOP_LINK_URL,
  license: "https://opensource.org/licenses/MIT",
  isAccessibleForFree: true,
  offers: { "@type": "Offer", price: "0", priceCurrency: "USD" },
  ...(release && { softwareVersion: release.version.replace(/^v/, "") }),
};
---

<Layout pageClass="lp">
  <!-- Runs before first paint. Order matters: Android UAs contain "Linux",
       iPhone UAs contain "Mac OS X", and iPadOS reports a Macintosh with touch. -->
  <script is:inline slot="head">
    (function () {
      var ua = navigator.userAgent;
      var os = /Android/i.test(ua)
        ? "android"
        : /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
          ? "ios"
          : /Win/.test(ua)
            ? "win"
            : /Mac/.test(ua)
              ? "mac"
              : /Linux/.test(ua)
                ? "linux"
                : "";
      if (os) document.documentElement.dataset.platform = os;
    })();
  </script>
  <script is:inline type="application/ld+json" slot="head" set:html={JSON.stringify(structuredData)} />
  <Hero />
  <Product />
  <Agents />
  <RemoteOpen />
  <HowItWorks />
  <Review />
  <Calm />
  <FinalCall />
</Layout>

<script>
  import { fetchLatestRelease } from "../lib/releases";

  /** Points the desktop download buttons at the latest release's files. */
  async function initDownload() {
    const buttons = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-asset]"));
    try {
      const assets = (await fetchLatestRelease()).assets ?? [];
      for (const button of buttons) {
        const match = assets.find((asset) => asset.name.endsWith(button.dataset.asset!));
        if (match) button.href = match.browser_download_url;
      }
    } catch {
      // The buttons already link to the releases page.
    }
  }

  /**
   * Wires one install block. CSS has already shown the command for the
   * detected platform; this only syncs aria-checked to it and handles a choice
   * made by hand, which it records as data-choice.
   */
  function initInstall(block: HTMLElement, platform: string | undefined) {
    const radios = Array.from(block.querySelectorAll<HTMLButtonElement>('[role="radio"]'));
    const mark = (os: string) => {
      for (const radio of radios) {
        const on = radio.dataset.os === os;
        radio.setAttribute("aria-checked", String(on));
        radio.tabIndex = on ? 0 : -1;
      }
    };
    const choose = (radio: HTMLButtonElement) => {
      block.dataset.choice = radio.dataset.os;
      mark(radio.dataset.os!);
      radio.focus();
    };
    mark(platform === "win" ? "windows" : "unix");

    const steps: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
    for (const radio of radios) {
      radio.addEventListener("click", () => choose(radio));
      radio.addEventListener("keydown", (event) => {
        const step = steps[event.key];
        if (!step) return;
        event.preventDefault();
        const next = radios[(radios.indexOf(radio) + step + radios.length) % radios.length];
        if (next) choose(next);
      });
    }

    for (const button of block.querySelectorAll<HTMLButtonElement>("[data-copy]")) {
      const label = button.querySelector("span")!;
      const command = button.previousElementSibling?.textContent ?? "";
      let reset: number | undefined;
      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(command);
          label.textContent = "Copied";
        } catch {
          label.textContent = "Select it";
        }
        window.clearTimeout(reset);
        reset = window.setTimeout(() => (label.textContent = "Copy"), 1600);
      });
    }
  }

  /**
   * The phone hero's "Share the desktop link". The share sheet needs the click's
   * user gesture and is missing in some browsers, so it falls back to copying
   * the link and says so on the button. Nothing is collected or sent anywhere.
   */
  function initShare(button: HTMLButtonElement) {
    const label = button.querySelector("span")!;
    const idle = label.textContent;
    const url = button.dataset.share!;
    const data = { title: "E6 Code", text: "Download E6 Code on your computer.", url };
    let reset: number | undefined;
    const say = (text: string) => {
      label.textContent = text;
      window.clearTimeout(reset);
      reset = window.setTimeout(() => (label.textContent = idle), 4000);
    };
    button.addEventListener("click", async () => {
      if (navigator.share && (!navigator.canShare || navigator.canShare(data))) {
        try {
          await navigator.share(data);
          return;
        } catch (error) {
          // The visitor closed the sheet.
          if (error instanceof DOMException && error.name === "AbortError") return;
        }
      }
      try {
        await navigator.clipboard.writeText(url);
        say("Link copied");
      } catch {
        say(`Go to ${url.replace("https://", "")}`);
      }
    });
  }

  // Set by the inline head script.
  const platform = document.documentElement.dataset.platform;
  if (platform === "mac" || platform === "win" || platform === "linux") void initDownload();
  for (const block of document.querySelectorAll<HTMLElement>("[data-install]")) initInstall(block, platform);
  for (const button of document.querySelectorAll<HTMLButtonElement>("[data-share]")) initShare(button);
</script>
