---
import { getImage } from "astro:assets";
import desktopScreenshot from "../assets/app-desktop.webp";
import Layout from "../layouts/Layout.astro";
import {
  ANDROID_PLAY_STORE_URL,
  GITHUB_REPOSITORY_URL,
  INSTALL_COMMANDS,
  IOS_APP_STORE_URL,
} from "../lib/site";

const screenshot = await getImage({
  src: desktopScreenshot,
  widths: [864, 1180],
  format: "webp",
  quality: 90,
});

// Sign-in steps mirror the README and docs/user/providers-*.md.
const agents = [
  {
    key: "claude",
    name: "Claude Code",
    icon: "/harnesses/claude-ai-icon.svg",
    command: "claude auth login",
    note: "Separate accounts per configuration, compaction for long threads, and OpenRouter-compatible routing.",
  },
  {
    key: "codex",
    name: "Codex",
    icon: "/harnesses/openai_dark.svg",
    command: "codex login",
    note: "The Codex CLI you already signed into. E6 Code drives it and leaves your plan alone.",
  },
  {
    key: "cursor",
    name: "Cursor",
    icon: "/harnesses/cursor_light.svg",
    command: "agent login",
    note: "Cursor's CLI agent, running on the machine that owns your workspace.",
  },
  {
    key: "grok",
    name: "Grok Build",
    icon: "/harnesses/grok-dark.svg",
    command: "grok login",
    note: "xAI's Grok Build CLI, in the same threads, diffs, and checkpoints as everything else.",
  },
  {
    key: "opencode",
    name: "OpenCode",
    icon: "/harnesses/opencode-dark.svg",
    command: "opencode auth login",
    note: "Use a local or external OpenCode server, with approvals surfaced in the thread.",
  },
  {
    key: "antigravity",
    name: "Antigravity",
    icon: "/harnesses/antigravity.png",
    command: "Settings → Install Antigravity",
    note: "No CLI required. Install it from Settings and sign in with Google, even from a remote device.",
  },
];

const routes = [
  {
    key: "local",
    prompt: "thanks, that fixed it!",
    verdict: "Answered locally",
    detail: "Small talk never wakes your provider. Zero provider tokens.",
  },
  {
    key: "trim",
    prompt: "what does this regex match?",
    verdict: "Trimmed context",
    detail: "A straightforward question goes to your agent with less context attached.",
  },
  {
    key: "full",
    prompt: "migrate the auth middleware to Effect",
    verdict: "Full turn",
    detail: "Real work gets the whole thread, exactly as if routing were off.",
  },
];

const connections = [
  {
    key: "lan",
    label: "Same network",
    command: "e6 serve --host <private-ip>",
    detail: "Enable Network access in Settings → Connections, then scan a one-time pairing link from your phone.",
  },
  {
    key: "tailscale",
    label: "Tailscale",
    command: "e6 serve --tailscale-serve",
    detail: "HTTPS across your tailnet. Both devices join the tailnet, then pair once.",
  },
  {
    key: "connect",
    label: "E6 Connect",
    command: "e6 connect",
    detail: "No port forwarding. Sign in on the host and on your other device, then choose the environment.",
  },
];

const turns = [
  { n: 1, title: "Scaffold settings panel", files: 4, add: 212, del: 0 },
  { n: 2, title: "Wire panel to contracts", files: 3, add: 64, del: 18 },
  { n: 3, title: "Fix stale label on reconnect", files: 1, add: 9, del: 5 },
  { n: 4, title: "Add focused tests", files: 2, add: 88, del: 2 },
];

const hosts = ["GitHub", "GitLab", "Bitbucket", "Azure DevOps", "Forgejo", "Gitea"];
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-scan" aria-hidden="true"></div>

    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="hero-signal" data-rise>
          <span class="signal-dot" data-motion aria-hidden="true"></span>
          6 agents · 3 surfaces · 0 tokens resold
        </p>

        <h1 class="hero-title">
          <span data-rise style="--d:80ms">Every coding agent.</span>
          <span data-rise style="--d:170ms" class="chrome-text">One control room.</span>
        </h1>

        <p class="hero-sub" data-rise style="--d:280ms">
          E6 Code runs Claude Code, Codex, Cursor, Grok, OpenCode, and Antigravity side by
          side, on your machine, with the subscriptions you already pay for. Drive it from
          the desktop, a browser, or your phone.
        </p>

        <div class="hero-actions" data-rise style="--d:380ms">
          <a id="download-btn" href="https://github.com/emikael/e6code/releases" class="btn btn-primary btn-lg">
            <span class="dl-icon dl-icon--apple" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 814 1000"><path fill="currentColor" d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57-155.5-127C46.7 790.7 0 663 0 541.8c0-194.4 126.4-297.5 250.8-297.5 66.1 0 121.2 43.4 162.7 43.4 39.5 0 101.1-46 176.3-46 28.5 0 130.9 2.6 198.3 99.2zm-234-181.5c31.1-36.9 53.1-88.1 53.1-139.3 0-7.1-.6-14.3-1.9-20.1-50.6 1.9-110.8 33.7-147.1 75.8-28.5 32.4-55.1 83.6-55.1 135.5 0 7.8 1.3 15.6 1.9 18.1 3.2.6 8.4 1.3 13.6 1.3 45.4 0 102.5-30.4 135.5-71.3z"/></svg></span>
            <span class="dl-icon dl-icon--windows" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 88 88"><path fill="currentColor" d="m0 12.402 35.687-4.86.016 34.423-35.67.203zm35.67 33.529.028 34.453L.028 75.48.026 45.7zm4.326-39.025L87.314 0v41.527l-47.318.376zm47.329 39.349-.011 41.34-47.318-6.678-.066-34.739z"/></svg></span>
            <span class="dl-icon dl-icon--linux" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 17l6-5-6-5M12 19h8"/></svg></span>
            <span id="download-label">Download for macOS</span>
          </a>
          <a class="btn btn-ghost btn-lg" href="/download">All platforms</a>
        </div>

        <p class="hero-mobile-line" data-rise style="--d:460ms">
          Also in your pocket:
          <a href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">iOS</a>
          <span aria-hidden="true">·</span>
          <a href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">Android</a>
        </p>
      </div>

      <div class="term install" data-rise style="--d:420ms">
        <div class="term-head">
          <span class="term-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <div class="seg" role="tablist" aria-label="Install command">
            <button type="button" role="tab" class="seg-btn" data-install="unix" aria-selected="true">macOS · Linux</button>
            <button type="button" role="tab" class="seg-btn" data-install="windows" aria-selected="false" tabindex="-1">Windows</button>
          </div>
        </div>
        <div class="term-body">
          <div class="install-line">
            <span class="prompt" aria-hidden="true">$</span>
            <code id="install-command" data-unix={INSTALL_COMMANDS.unix} data-windows={INSTALL_COMMANDS.windows}>{INSTALL_COMMANDS.unix}</code>
            <button type="button" class="copy-btn" id="install-copy" aria-label="Copy install command">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="9" y="9" width="12" height="12" rx="2"/><path d="M5 15V5a2 2 0 012-2h10"/></svg>
              <span class="copy-label">Copy</span>
            </button>
          </div>
          <div class="dim"><span class="prompt" aria-hidden="true">$</span> e6</div>
          <div class="dim">→ server up, web app opens in your browser</div>
          <div class="dim"><span class="prompt" aria-hidden="true">$</span> e6 service install <span class="faint"># keep it running</span></div>
          <div class="cursor-line"><span class="prompt" aria-hidden="true">$</span><span class="caret" data-motion></span></div>
        </div>
      </div>
    </div>

    <div class="container" data-rise style="--d:560ms">
      <figure class="shot">
        <img
          src={desktopScreenshot.src}
          srcset={`${screenshot.srcSet.attribute}, ${desktopScreenshot.src} ${desktopScreenshot.width}w`}
          sizes="(max-width: 1240px) calc(100vw - 40px), 1176px"
          alt="The E6 Code desktop app: a Claude Code thread explaining its retry change beside the turn's diff"
          width={desktopScreenshot.width}
          height={desktopScreenshot.height}
          loading="eager"
          decoding="async"
        />
      </figure>
    </div>
  </section>

  <!-- ── Agents ─────────────────────────────────────────────────── -->
  <section id="agents" class="sec">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">01</span> Bring your own subscription</p>
        <h2>Sign in where you already do. We take it from there.</h2>
        <p>
          E6 Code doesn't resell tokens or proxy your keys. It drives the provider CLIs
          installed on your machine, so your plan, limits, and credentials stay yours.
          Pick a harness per thread.
        </p>
      </div>

      <div class="agent-console">
        <div class="agent-rail" role="tablist" aria-label="Providers" aria-orientation="vertical">
          {agents.map((agent, index) => (
            <button
              type="button"
              role="tab"
              class="agent-tab"
              id={`agent-tab-${agent.key}`}
              aria-controls="agent-panel"
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
              data-command={agent.command}
              data-note={agent.note}
              data-name={agent.name}
            >
              <span class:list={["agent-mark", agent.key === "antigravity" && "agent-mark--fill"]}><img src={agent.icon} alt="" width="20" height="20" /></span>
              <span>{agent.name}</span>
            </button>
          ))}
        </div>

        <div class="term agent-panel" id="agent-panel" role="tabpanel" aria-labelledby={`agent-tab-${agents[0]!.key}`}>
          <div class="term-head">
            <span class="term-lights" aria-hidden="true"><i></i><i></i><i></i></span>
            <span class="term-title">~/work · <span id="agent-name">{agents[0]!.name}</span></span>
          </div>
          <div class="term-body">
            <div><span class="prompt" aria-hidden="true">$</span> <span id="agent-command">{agents[0]!.command}</span></div>
            <div class="ok-line" id="agent-ok">✓ Signed in. E6 Code picks it up on the next scan.</div>
            <p class="agent-note" id="agent-note">{agents[0]!.note}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Routing ────────────────────────────────────────────────── -->
  <section id="routing" class="sec sec-routing">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">02</span> Jev routing · opt-in</p>
        <h2>Not every message deserves a frontier model.</h2>
        <p>
          Turn on Jev routing and each turn is classified before it reaches your agent.
          Greetings and quick lookups get answered without calling your provider, and simple
          questions go out with trimmed context. Try a message:
        </p>
      </div>

      <div class="router" id="router" data-route="">
        <div class="router-prompts" role="group" aria-label="Sample messages">
          {routes.map((route) => (
            <button type="button" class="router-chip" data-route-key={route.key} data-verdict={route.verdict} data-detail={route.detail} aria-pressed="false">
              <span class="prompt" aria-hidden="true">›</span> {route.prompt}
            </button>
          ))}
        </div>

        <svg class="router-graph" viewBox="0 0 640 220" role="img" aria-label="A message enters Jev, which sends it to one of three outlets: answered locally, trimmed context to your agent, or the full turn to your agent.">
          <path class="wire wire-in" d="M20 110 H250" />
          <path class="wire wire-local" d="M330 110 C 400 110, 410 40, 470 40 H 620" />
          <path class="wire wire-trim" d="M330 110 H 620" />
          <path class="wire wire-full" d="M330 110 C 400 110, 410 180, 470 180 H 620" />
          <rect class="router-node" x="250" y="82" width="80" height="56" rx="12" />
          <text class="router-node-label" x="290" y="116" text-anchor="middle">Jev</text>
          <text class="outlet outlet-local" x="620" y="28" text-anchor="end">answered locally</text>
          <text class="outlet outlet-trim" x="620" y="98" text-anchor="end">trimmed → your agent</text>
          <text class="outlet outlet-full" x="620" y="168" text-anchor="end">full turn → your agent</text>
        </svg>

        <div class="router-readout" aria-live="polite">
          <strong id="router-verdict">Pick a message</strong>
          <span id="router-detail">See where it would go.</span>
        </div>
      </div>

      <ul class="facts">
        <li><b>$0.042</b> per million input tokens, metered per call</li>
        <li><b>Usage</b> shows avoided provider calls next to Jev cost</li>
        <li><b>Your key</b> stays on your server. Turn content goes to the Jev API</li>
      </ul>
    </div>
  </section>

  <!-- ── Remote ─────────────────────────────────────────────────── -->
  <section id="remote" class="sec">
    <div class="container split split--reverse">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">03</span> Remote ready</p>
        <h2>Your agents keep working. You don't have to sit there.</h2>
        <p>
          The server lives on the machine with your code. Phones, browsers, and other
          desktops connect to it over your network, your tailnet, or E6 Connect. With two or
          more machines connected, new threads can balance across them.
        </p>
        <p class="store-line">
          <a class="btn btn-ghost" href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">iOS app</a>
          <a class="btn btn-ghost" href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">Android app</a>
        </p>
      </div>

      <div class="remote" id="remote-visual" data-mode="lan">
        <div class="seg remote-seg" role="tablist" aria-label="Connection mode">
          {connections.map((mode, index) => (
            <button
              type="button"
              role="tab"
              class="seg-btn"
              data-mode={mode.key}
              data-command={mode.command}
              data-detail={mode.detail}
              aria-selected={index === 0 ? "true" : "false"}
              tabindex={index === 0 ? "0" : "-1"}
            >
              {mode.label}
            </button>
          ))}
        </div>

        <div class="remote-map" aria-hidden="true">
          <div class="device device-host">
            <span class="device-kind">host</span>
            <span class="device-name">workstation</span>
            <span class="device-meta"><span class="signal-dot"></span>3 threads running</span>
          </div>
          <svg class="remote-links" viewBox="0 0 300 200" preserveAspectRatio="none">
            <path d="M0 100 C 120 100, 150 30, 300 30" />
            <path d="M0 100 H 300" />
            <path d="M0 100 C 120 100, 150 170, 300 170" />
          </svg>
          <div class="device-stack">
            <div class="device"><span class="device-kind">phone</span><span class="device-name">iPhone</span></div>
            <div class="device"><span class="device-kind">browser</span><span class="device-name">any laptop</span></div>
            <div class="device"><span class="device-kind">desktop</span><span class="device-name">second Mac</span></div>
          </div>
        </div>

        <div class="term remote-term">
          <div class="term-body">
            <div><span class="prompt" aria-hidden="true">$</span> <span id="remote-command">{connections[0]!.command}</span></div>
            <p class="agent-note" id="remote-detail" aria-live="polite">{connections[0]!.detail}</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Checkpoints & Git ──────────────────────────────────────── -->
  <section id="git" class="sec">
    <div class="container split">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">04</span> Checkpoints &amp; Git</p>
        <h2>Every turn is a checkpoint. Every thread can be a PR.</h2>
        <p>
          Each turn ends with a hidden git ref, so you can diff exactly what the agent changed
          and rewind when it wanders. Edit an earlier prompt to revert the thread, files
          included in worktrees. When it's right, commit, push, and open the pull request
          without leaving the thread.
        </p>
        <ul class="hosts" aria-label="Supported source control hosts">
          {hosts.map((host) => <li>{host}</li>)}
        </ul>
      </div>

      <div class="timeline" id="timeline">
        <div class="timeline-turns" role="tablist" aria-label="Turns">
          {turns.map((turn) => (
            <button
              type="button"
              role="tab"
              class="turn"
              aria-selected={turn.n === turns.length ? "true" : "false"}
              tabindex={turn.n === turns.length ? "0" : "-1"}
              data-title={turn.title}
              data-files={turn.files}
              data-add={turn.add}
              data-del={turn.del}
              data-n={turn.n}
            >
              <span class="turn-dot" aria-hidden="true"></span>
              <span>Turn {turn.n}</span>
            </button>
          ))}
        </div>
        <div class="term turn-card" aria-live="polite">
          <div class="term-body">
            <div class="turn-card-title" id="turn-title">{turns.at(-1)!.title}</div>
            <div class="turn-card-meta">
              <span id="turn-files">{turns.at(-1)!.files} files</span>
              <span class="add" id="turn-add">+{turns.at(-1)!.add}</span>
              <span class="del" id="turn-del">−{turns.at(-1)!.del}</span>
            </div>
            <div class="turn-card-actions">
              <span class="pill" id="turn-action">Latest checkpoint</span>
              <span class="pill pill--primary">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="6" cy="6" r="2.2"/><circle cx="6" cy="18" r="2.2"/><circle cx="18" cy="6" r="2.2"/><path d="M6 8v8M18 8v5a3 3 0 01-3 3h-3"/></svg>
                Commit, push &amp; open PR
              </span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Open source ────────────────────────────────────────────── -->
  <section id="open" class="sec">
    <div class="container split split--reverse">
      <div class="section-head">
        <p class="eyebrow"><span class="idx">05</span> Open at the core</p>
        <h2>Don't like a decision? Fork it.</h2>
        <p>
          E6 Code is MIT licensed and built in the open. Restyle every surface, wire in your
          own agent, or ship your own build. If we ever head the wrong way, you already have
          everything you need.
        </p>
        <p class="store-line">
          <a class="btn btn-primary" href={`${GITHUB_REPOSITORY_URL}/fork`} target="_blank" rel="noopener noreferrer">Fork on GitHub</a>
          <a class="btn btn-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Browse source</a>
        </p>
      </div>

      <div class="term">
        <div class="term-head">
          <span class="term-lights" aria-hidden="true"><i></i><i></i><i></i></span>
          <span class="term-title">~/code</span>
        </div>
        <div class="term-body">
          <div><span class="prompt" aria-hidden="true">$</span> gh repo fork emikael/e6code --clone</div>
          <div class="dim">✓ Cloned into ./e6code</div>
          <div><span class="prompt" aria-hidden="true">$</span> cd e6code &amp;&amp; vp i</div>
          <div class="dim">✓ Dependencies installed</div>
          <div><span class="prompt" aria-hidden="true">$</span> vp run dev</div>
          <div class="dim">▲ server + web running · <span class="accent">your fork, your rules</span></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ──────────────────────────────────────────────── -->
  <section id="download" class="sec sec-cta">
    <div class="container cta-inner">
      <h2 class="cta-title">Your agents deserve<br /><span class="chrome-text">better than a terminal.</span></h2>
      <p class="cta-sub">Free and open source. Install it, plug in the harness you already pay for, and get back to the work only you can do.</p>
      <div class="hero-actions cta-actions">
        <a id="cta-download-btn" class="btn btn-primary btn-lg" href="https://github.com/emikael/e6code/releases">
          <span id="cta-download-label">Download for macOS</span>
        </a>
        <a class="btn btn-ghost btn-lg" href="/download">Windows · Linux · other</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";
  import { startHomeMotion } from "../lib/homeMotion";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  const byId = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  async function initDownload(platform: Platform) {
    const buttons = [byId<HTMLAnchorElement>("download-btn"), byId<HTMLAnchorElement>("cta-download-btn")];
    for (const label of [byId("download-label"), byId("cta-download-label")]) {
      if (label) label.textContent = platform.label;
    }
    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (!url) return;
      for (const btn of buttons) if (btn) btn.href = url;
    } catch {
      for (const btn of buttons) if (btn) btn.href = RELEASES_URL;
    }
  }

  /** Wires a tab group: click or arrow keys select, `onSelect` renders the panel. */
  function tabs(buttons: HTMLElement[], onSelect: (button: HTMLElement) => void) {
    const select = (button: HTMLElement, focus = false) => {
      for (const b of buttons) {
        const on = b === button;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
      }
      if (focus) button.focus();
      onSelect(button);
    };
    const steps: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
    for (const button of buttons) {
      button.addEventListener("click", () => select(button));
      button.addEventListener("keydown", (event) => {
        const step = steps[event.key];
        if (!step) return;
        event.preventDefault();
        const next = buttons[(buttons.indexOf(button) + step + buttons.length) % buttons.length];
        if (next) select(next, true);
      });
    }
    return select;
  }

  // Retypes a short string so switching providers reads like a live terminal.
  let typing: number | undefined;
  function typeInto(element: HTMLElement, text: string, done: () => void) {
    window.clearInterval(typing);
    if (reducedMotion.matches) {
      element.textContent = text;
      done();
      return;
    }
    let i = 0;
    element.textContent = "";
    typing = window.setInterval(() => {
      element.textContent = text.slice(0, ++i);
      if (i >= text.length) {
        window.clearInterval(typing);
        done();
      }
    }, 22);
  }

  function initInstall(platform: Platform | null) {
    const code = byId("install-command");
    const copy = byId("install-copy");
    if (!code || !copy) return;
    const buttons = Array.from(document.querySelectorAll<HTMLElement>("[data-install]"));
    const select = tabs(buttons, (button) => {
      code.textContent = button.dataset.install === "windows" ? code.dataset.windows! : code.dataset.unix!;
    });
    if (platform?.os === "win" && buttons[1]) select(buttons[1]);

    const label = copy.querySelector(".copy-label")!;
    let reset: number | undefined;
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "Copied";
      } catch {
        label.textContent = "Select it";
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => (label.textContent = "Copy"), 1600);
    });
  }

  function initAgents() {
    const command = byId("agent-command");
    const note = byId("agent-note");
    const name = byId("agent-name");
    const ok = byId("agent-ok");
    const panel = byId("agent-panel");
    if (!command || !note || !name || !ok || !panel) return;
    ok.classList.add("is-shown");
    tabs(Array.from(document.querySelectorAll<HTMLElement>(".agent-tab")), (button) => {
      panel.setAttribute("aria-labelledby", button.id);
      name.textContent = button.dataset.name ?? "";
      note.textContent = button.dataset.note ?? "";
      ok.classList.remove("is-shown");
      typeInto(command, button.dataset.command ?? "", () => ok.classList.add("is-shown"));
    });
  }

  function initRouter() {
    const router = byId("router");
    const verdict = byId("router-verdict");
    const detail = byId("router-detail");
    if (!router || !verdict || !detail) return;
    const chips = Array.from(router.querySelectorAll<HTMLElement>(".router-chip"));
    for (const chip of chips) {
      chip.addEventListener("click", () => {
        for (const c of chips) c.setAttribute("aria-pressed", String(c === chip));
        // Clearing first lets the one-shot trace replay on repeat clicks.
        router.dataset.route = "";
        void router.offsetWidth;
        router.dataset.route = chip.dataset.routeKey ?? "";
        verdict.textContent = chip.dataset.verdict ?? "";
        detail.textContent = chip.dataset.detail ?? "";
      });
    }
  }

  function initRemote() {
    const visual = byId("remote-visual");
    const command = byId("remote-command");
    const detail = byId("remote-detail");
    if (!visual || !command || !detail) return;
    tabs(Array.from(visual.querySelectorAll<HTMLElement>("button[data-mode]")), (button) => {
      visual.dataset.mode = button.dataset.mode ?? "";
      command.textContent = button.dataset.command ?? "";
      detail.textContent = button.dataset.detail ?? "";
    });
  }

  function initTimeline() {
    const timeline = byId("timeline");
    const title = byId("turn-title");
    const files = byId("turn-files");
    const add = byId("turn-add");
    const del = byId("turn-del");
    const action = byId("turn-action");
    if (!timeline || !title || !files || !add || !del || !action) return;
    const buttons = Array.from(timeline.querySelectorAll<HTMLElement>(".turn"));
    tabs(buttons, (button) => {
      const { title: t, files: f, add: a, del: d, n } = button.dataset;
      title.textContent = t ?? "";
      files.textContent = `${f} file${f === "1" ? "" : "s"}`;
      add.textContent = `+${a}`;
      del.textContent = `−${d}`;
      action.textContent = Number(n) === buttons.length ? "Latest checkpoint" : `Rewind to turn ${n}`;
      timeline.style.setProperty("--progress", String((Number(n) - 1) / (buttons.length - 1)));
    });
  }

  const platform = detectPlatform();
  if (platform) {
    document.documentElement.dataset.platform = platform.os;
    void initDownload(platform);
  }
  initInstall(platform);
  initAgents();
  initRouter();
  initRemote();
  initTimeline();
  startHomeMotion(Array.from(document.querySelectorAll<HTMLElement>("[data-motion]")));
</script>

