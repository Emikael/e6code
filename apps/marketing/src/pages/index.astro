---
import { getImage } from "astro:assets";
import threadDark from "../assets/app-thread-dark.webp";
import threadLight from "../assets/app-thread-light.webp";
import settingsDark from "../assets/app-settings-dark.webp";
import Layout from "../layouts/Layout.astro";
import { RELEASES_URL } from "../lib/releases";
import {
  ANDROID_PLAY_STORE_URL,
  GITHUB_REPOSITORY_URL,
  INSTALL_COMMANDS,
  IOS_APP_STORE_URL,
} from "../lib/site";

// Screenshots are 2x captures of the desktop app at 1440x900.
const shotWidths = [960, 1440, 2160];
const [threadDarkSet, threadLightSet, settingsSet] = await Promise.all(
  [threadDark, threadLight, settingsDark].map((src) =>
    getImage({ src, widths: shotWidths, format: "webp", quality: 86 }),
  ),
);

// One download button per platform, all pre-rendered. The inline head script
// below sets html[data-platform] before first paint and CSS shows the matching
// button, so the label never swaps after load. Desktop buttons carry the
// release asset suffix; the page script points them at the file once the latest
// release is fetched.
// Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
// from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
// Silicon user a broken app. Intel users pick their build on /download.
// Do NOT add arch detection back here.
const downloads = [
  { os: "mac", label: "Download for macOS", href: RELEASES_URL, asset: "-arm64.dmg" },
  { os: "win", label: "Download for Windows", href: RELEASES_URL, asset: "-x64.exe" },
  { os: "linux", label: "Download for Linux", href: RELEASES_URL, asset: "-x86_64.AppImage" },
  { os: "ios", label: "Get the iOS app", href: IOS_APP_STORE_URL },
  { os: "android", label: "Get the Android app", href: ANDROID_PLAY_STORE_URL },
];

// Sign-in steps mirror the README and docs/user/providers-*.md. Marks render as
// one-colour masks so they follow the theme.
const agents = [
  { name: "Claude Code", icon: "/harnesses/claude-ai-icon.svg", command: "claude auth login" },
  { name: "Codex", icon: "/harnesses/openai_dark.svg", command: "codex login" },
  { name: "Cursor", icon: "/harnesses/cursor_light.svg", command: "agent login" },
  { name: "Grok Build", icon: "/harnesses/grok-dark.svg", command: "grok login" },
  { name: "OpenCode", icon: "/harnesses/opencode-mark.svg", command: "opencode auth login" },
  { name: "Antigravity", icon: "/harnesses/antigravity.png", command: "Settings → Install", fullColor: true },
];

const stats = [
  { value: 6, label: "agent harnesses" },
  { value: 3, label: "surfaces: desktop, web, phone" },
  { value: 6, label: "git hosts for pull requests" },
  { value: 0, label: "tokens resold" },
];

// Mirrors the subagents in the hero screenshot. Each state carries a word.
const subagents = [
  { name: "Dashboard share button", meta: "sonnet-4-5 · medium · 9.7K tok · 5 tools", state: "Working", tone: "live" },
  { name: "Share link API", meta: "opus-4-5 · high · 3 files · +247 −6", state: "Needs approval", tone: "wait" },
  { name: "Share link tests", meta: "asks: which share link expiry should the tests cover?", state: "Needs your answer", tone: "ask" },
  { name: "Share link docs", meta: "sonnet-4-5 · 2 files · +76 −3 · 26s", state: "Done", tone: "done" },
];

const turns = [
  { n: 1, title: "Scaffold settings panel", add: 212, del: 0 },
  { n: 2, title: "Wire panel to contracts", add: 64, del: 18 },
  { n: 3, title: "Fix stale label on reconnect", add: 9, del: 5 },
  { n: 4, title: "Add focused tests", add: 88, del: 2 },
];

const hosts = ["GitHub", "GitLab", "Bitbucket", "Azure DevOps", "Forgejo", "Gitea"];

const routes = [
  { key: "local", prompt: "thanks, that fixed it!", verdict: "Answered locally" },
  { key: "trim", prompt: "what does this regex match?", verdict: "Trimmed context" },
  { key: "full", prompt: "migrate the auth middleware", verdict: "Full turn" },
];

const commands = [
  { label: "New thread", keys: ["⌘", "⇧", "O"] },
  { label: "Search threads", keys: ["⌘", "K"] },
  { label: "Toggle run details", keys: ["⌘", "I"] },
];

const connections = [
  {
    key: "lan",
    label: "Same network",
    command: "e6 serve --host <private-ip>",
    detail: "Turn on Network access in Settings → Connections, then scan a one-time pairing link from your phone.",
  },
  {
    key: "tailscale",
    label: "Tailscale",
    command: "e6 serve --tailscale-serve",
    detail: "HTTPS across your tailnet. Both devices join the tailnet, then pair once.",
  },
  {
    key: "connect",
    label: "E6 Connect",
    command: "e6 connect",
    detail: "No port forwarding. Sign in on the host and on your other device, then choose the environment.",
  },
];

const devices = [
  { kind: "phone", name: "iPhone", y: 40 },
  { kind: "browser", name: "Any browser", y: 130 },
  { kind: "desktop", name: "Second Mac", y: 220 },
];
---

<Layout>
  <!-- Runs before first paint. Order matters: Android UAs contain "Linux",
       iPhone UAs contain "Mac OS X", and iPadOS reports a Macintosh with touch. -->
  <script is:inline slot="head">
    (function () {
      var ua = navigator.userAgent;
      var os = /Android/i.test(ua)
        ? "android"
        : /iPhone|iPad|iPod/.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1)
          ? "ios"
          : /Win/.test(ua)
            ? "win"
            : /Mac/.test(ua)
              ? "mac"
              : /Linux/.test(ua)
                ? "linux"
                : "";
      if (os) document.documentElement.dataset.platform = os;
    })();
  </script>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <div class="hero-grid"></div>
    </div>
    <div class="container hero-inner">
      <a class="hero-badge" href="#features" data-rise>
        <span class="badge-new">New</span>
        <span>The macOS redesign is here</span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
      </a>
      <h1 class="hero-title" data-rise style="--d:60ms">
        Every coding agent.<br />One control room.
      </h1>
      <p class="hero-sub" data-rise style="--d:120ms">
        Run Claude Code, Codex, Cursor, Grok Build, OpenCode, and Antigravity side by side, on your
        machine, with the subscriptions you already pay for. Drive it from the desktop, a browser, or
        your phone.
      </p>
      <div class="hero-actions" data-rise style="--d:180ms">
        {downloads.map((download) => (
          <a class:list={["btn btn-primary btn-lg dl", `dl--${download.os}`]} href={download.href} data-asset={download.asset}>
            {download.asset && (
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3" /><path d="m7 10 5 5 5-5" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /></svg>
            )}
            <span>{download.label}</span>
          </a>
        ))}
        <a class="btn btn-ghost btn-lg" href="/download">All platforms</a>
      </div>

      <div class="install" data-rise style="--d:240ms">
        <div class="seg" role="tablist" aria-label="Install command">
          <button type="button" role="tab" class="seg-btn" data-install="unix" aria-selected="true">macOS · Linux</button>
          <button type="button" role="tab" class="seg-btn" data-install="windows" aria-selected="false" tabindex="-1">Windows</button>
        </div>
        <div class="install-line">
          <span class="prompt" aria-hidden="true">$</span>
          <code id="install-command" data-unix={INSTALL_COMMANDS.unix} data-windows={INSTALL_COMMANDS.windows}>{INSTALL_COMMANDS.unix}</code>
          <button type="button" class="copy-btn" id="install-copy" aria-label="Copy install command">
            <span class="copy-label" aria-live="polite">Copy</span>
          </button>
        </div>
      </div>

      <p class="hero-mobile-line" data-rise style="--d:300ms">
        Also on <a href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">iOS</a> and <a href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">Android</a>. Free and MIT licensed.
      </p>
    </div>

    <!-- Product shot: tilts back in 3D and settles flat as you scroll. -->
    <div class="container tilt-stage">
      <figure class="tilt">
        <div class="tilt-frame">
          <picture>
            <source media="(prefers-color-scheme: light)" srcset={threadLightSet.srcSet.attribute} sizes="(max-width: 1240px) calc(100vw - 72px), 1160px" />
            <img
              src={threadDarkSet.src}
              srcset={threadDarkSet.srcSet.attribute}
              sizes="(max-width: 1240px) calc(100vw - 72px), 1160px"
              alt="An E6 Code thread in which Claude splits the work across four subagents: one working, one waiting for approval, one asking a question and one done, beside the run details panel with context, changes and the live subagent"
              width={threadDark.width}
              height={threadDark.height}
              loading="eager"
              decoding="async"
            />
          </picture>
        </div>
      </figure>
    </div>
  </section>

  <!-- ── Agents ─────────────────────────────────────────────────── -->
  <section class="logos" aria-labelledby="logos-title">
    <h2 id="logos-title" class="container">Sign in where you already do. E6 Code drives the CLI you have.</h2>
    <ul class="container logo-list">
      {agents.map((agent) => (
        <li class="logo-chip">
          {agent.fullColor ? (
            <img class="logo-img" src={agent.icon} alt="" width="26" height="26" loading="lazy" />
          ) : (
            <span class="logo-mark" style={`--logo: url(${agent.icon})`} aria-hidden="true"></span>
          )}
          <span class="logo-text">
            <span class="logo-name">{agent.name}</span>
            <span class="mono logo-cmd">{agent.command}</span>
          </span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Stats ──────────────────────────────────────────────────── -->
  <section class="container stats reveal" aria-label="E6 Code in numbers">
    {stats.map((stat) => (
      <div class="stat">
        <span class="stat-value">{stat.value}</span>
        <span class="stat-label">{stat.label}</span>
      </div>
    ))}
  </section>

  <!-- ── Features bento ─────────────────────────────────────────── -->
  <section id="features" class="sec container" aria-labelledby="features-title">
    <div class="section-head center reveal">
      <p class="eyebrow">What you get</p>
      <h2 id="features-title">The agent's work is the brightest thing on screen.</h2>
      <p>Plans, subagents, diffs, and approvals sit in calm panels. The chrome stays out of the way.</p>
    </div>

    <div class="bento">
      <article class="spot card span-4 reveal">
        <div class="card-head">
          <span class="card-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5" /><rect x="14" y="3" width="7" height="7" rx="1.5" /><rect x="3" y="14" width="7" height="7" rx="1.5" /><rect x="14" y="14" width="7" height="7" rx="1.5" /></svg></span>
          <h3>Watch the run, not just the reply</h3>
          <p>Split work across subagents and see each one's state, model, cost, and files. Destructive commands need a one-second hold to allow.</p>
        </div>
        <ul class="list">
          {subagents.map((agent, index) => (
            <li class="list-row" style={`--i:${index}`}>
              <span class="list-main">
                <span class="list-title">{agent.name}</span>
                <span class="mono list-meta">{agent.meta}</span>
              </span>
              <span class:list={["state", `state--${agent.tone}`]}>
                <span class="state-dot" aria-hidden="true"></span>{agent.state}
              </span>
            </li>
          ))}
        </ul>
      </article>

      <article class="spot card span-2 reveal">
        <div class="card-head">
          <span class="card-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M12 3v6" /><path d="M12 15v6" /></svg></span>
          <h3>Every turn is a checkpoint</h3>
          <p>A hidden git ref after each turn. Diff it, or rewind when it wanders.</p>
        </div>
        <ol class="turns">
          {turns.map((turn) => (
            <li>
              <span class="turn-dot" aria-hidden="true"></span>
              <span class="turn-title">Turn {turn.n} · {turn.title}</span>
              <span class="mono add">+{turn.add}</span>
              <span class="mono del">−{turn.del}</span>
            </li>
          ))}
        </ol>
      </article>

      <article class="spot card span-2 reveal">
        <div class="card-head">
          <span class="card-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="6" cy="6" r="2.2" /><circle cx="6" cy="18" r="2.2" /><circle cx="18" cy="6" r="2.2" /><path d="M6 8v8M18 8v5a3 3 0 0 1-3 3h-3" /></svg></span>
          <h3>Every thread can be a PR</h3>
          <p>Commit, push, and open the pull request without leaving the thread.</p>
        </div>
        <ul class="chips">
          {hosts.map((host) => <li class="mono">{host}</li>)}
        </ul>
        <div class="pr-row">
          <span class="list-main">
            <span class="list-title">Add share links to dashboards</span>
            <span class="mono list-meta"><span class="add">+323</span> <span class="del">−9</span> · 4 files</span>
          </span>
          <span class="pr-btn">Open PR</span>
        </div>
      </article>

      <article class="spot card span-2 reveal">
        <div class="card-head">
          <span class="card-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M16 3h5v5" /><path d="M8 3H3v5" /><path d="M12 22v-8.3a4 4 0 0 0-1.17-2.83L3 3" /><path d="m15 9 6-6" /></svg></span>
          <h3>Jev routing, if you want it</h3>
          <p>Each turn is classified first. Small talk never wakes your provider.</p>
        </div>
        <div class="router">
          <svg class="router-svg" viewBox="0 0 300 150" aria-hidden="true">
            <path class="wire" d="M10 75 H120" />
            <path class="wire" d="M180 75 C 220 75, 225 25, 290 25" />
            <path class="wire" d="M180 75 H 290" />
            <path class="wire" d="M180 75 C 220 75, 225 125, 290 125" />
            <rect class="router-node" x="120" y="55" width="60" height="40" rx="10" />
            <text class="router-label" x="150" y="80" text-anchor="middle">Jev</text>
          </svg>
          <ul class="routes">
            {routes.map((route) => (
              <li>
                <span class="mono">› {route.prompt}</span>
                <strong>{route.verdict}</strong>
              </li>
            ))}
          </ul>
        </div>
      </article>

      <article class="spot card span-2 reveal">
        <div class="card-head">
          <span class="card-icon" aria-hidden="true"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6v12a3 3 0 1 0 3-3H6a3 3 0 1 0 3 3V6a3 3 0 1 0-3 3h12a3 3 0 1 0-3-3" /></svg></span>
          <h3>Keyboard first, touch equal</h3>
          <p>Every action is in the command palette, with keybindings you can change.</p>
        </div>
        <div class="palette" aria-hidden="true">
          <div class="palette-search">Search commands…</div>
          {commands.map((command, index) => (
            <div class:list={["palette-row", index === 0 && "is-active"]}>
              <span>{command.label}</span>
              <span class="keys">{command.keys.map((key) => <kbd>{key}</kbd>)}</span>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <!-- ── Remote ─────────────────────────────────────────────────── -->
  <section id="remote" class="sec container split" aria-labelledby="remote-title">
    <div class="section-head reveal">
      <p class="eyebrow">Remote ready</p>
      <h2 id="remote-title">Your agents keep working. You don't have to sit there.</h2>
      <p>
        The server lives on the machine with your code. Phones, browsers, and other desktops connect
        over your network, your tailnet, or E6 Connect. With two or more machines connected, new
        threads can balance across them.
      </p>
      <p class="store-line">
        <a class="btn btn-ghost" href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">iOS app</a>
        <a class="btn btn-ghost" href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">Android app</a>
      </p>
    </div>
    <div class="spot card remote reveal" id="remote-visual">
      <div class="seg seg--bar" role="tablist" aria-label="Connection mode">
        {connections.map((mode, index) => (
          <button
            type="button"
            role="tab"
            class="seg-btn"
            data-mode={mode.key}
            data-command={mode.command}
            data-detail={mode.detail}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
          >
            {mode.label}
          </button>
        ))}
      </div>
      <div class="beams">
        <svg viewBox="0 0 400 260" preserveAspectRatio="none" aria-hidden="true">
          {devices.map((device) => (
            <path class="wire" d={`M120 130 C 220 130, 220 ${device.y}, 300 ${device.y}`} />
          ))}
        </svg>
        <div class="node node--host">
          <span class="node-kind mono">host</span>
          <span class="node-name">Workstation</span>
          <span class="node-state"><span class="state-dot state-dot--ok" aria-hidden="true"></span>3 threads running</span>
        </div>
        {devices.map((device) => (
          <div class="node node--device" style={`--y:${device.y}`}>
            <span class="node-kind mono">{device.kind}</span>
            <span class="node-name">{device.name}</span>
          </div>
        ))}
      </div>
      <div class="remote-body">
        <div class="well mono"><span class="prompt" aria-hidden="true">$</span> <span id="remote-command">{connections[0]!.command}</span></div>
        <p id="remote-detail" aria-live="polite">{connections[0]!.detail}</p>
      </div>
    </div>
  </section>

  <!-- ── Themes: before/after slider ────────────────────────────── -->
  <section class="sec container" aria-labelledby="themes-title">
    <div class="section-head center reveal">
      <p class="eyebrow">Make it yours</p>
      <h2 id="themes-title">Porcelain by day, Slate by night.</h2>
      <p>Drag to compare. Two quiet themes and four accents, and the accent only ever marks the next action or a working agent.</p>
    </div>
    <div class="compare reveal" id="compare" style="--pos: 50%">
      <img
        class="compare-img"
        src={threadDarkSet.src}
        srcset={threadDarkSet.srcSet.attribute}
        sizes="(max-width: 1240px) calc(100vw - 64px), 1176px"
        alt="The thread in the Slate theme"
        width={threadDark.width}
        height={threadDark.height}
        loading="lazy"
        decoding="async"
      />
      <img
        class="compare-img compare-top"
        src={threadLightSet.src}
        srcset={threadLightSet.srcSet.attribute}
        sizes="(max-width: 1240px) calc(100vw - 64px), 1176px"
        alt="The same thread in the Porcelain theme"
        width={threadLight.width}
        height={threadLight.height}
        loading="lazy"
        decoding="async"
      />
      <span class="compare-tag compare-tag--left">Porcelain</span>
      <span class="compare-tag compare-tag--right">Slate</span>
      <span class="compare-handle" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18-6-6 6-6" /><path d="m15 6 6 6-6 6" /></svg>
      </span>
      <input class="compare-range" type="range" min="0" max="100" value="50" aria-label="Compare the Porcelain and Slate themes" />
    </div>
    <div class="spot card accents-row reveal">
      <figure class="settings-thumb">
        <img
          src={settingsSet.src}
          srcset={settingsSet.srcSet.attribute}
          sizes="(max-width: 960px) calc(100vw - 64px), 560px"
          alt="E6 Code Appearance settings with the Match system, Porcelain, and Slate themes and the Iris, Cobalt, Rose, and Graphite accents"
          width={settingsDark.width}
          height={settingsDark.height}
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="accents-copy">
        <h3>Four accents, one meaning</h3>
        <p>Pick Iris, Cobalt, Rose, or Graphite in Settings → Appearance. Surfaces stay neutral, and status keeps its own colours and words.</p>
        <ul class="accents">
        <li><span class="swatch swatch--iris" aria-hidden="true"></span>Iris</li>
        <li><span class="swatch swatch--cobalt" aria-hidden="true"></span>Cobalt</li>
        <li><span class="swatch swatch--rose" aria-hidden="true"></span>Rose</li>
        <li><span class="swatch swatch--graphite" aria-hidden="true"></span>Graphite</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Open source ────────────────────────────────────────────── -->
  <section id="open" class="sec container" aria-labelledby="open-title">
    <div class="spot card open reveal">
      <div class="section-head">
        <p class="eyebrow">Open at the core</p>
        <h2 id="open-title">Don't like a decision? Fork it.</h2>
        <p>
          E6 Code is MIT licensed and built in the open. It doesn't resell tokens or proxy your keys,
          so your plan, limits, and credentials stay yours.
        </p>
        <p class="store-line">
          <a class="btn btn-primary" href={`${GITHUB_REPOSITORY_URL}/fork`} target="_blank" rel="noopener noreferrer">Fork on GitHub</a>
          <a class="btn btn-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Browse source</a>
        </p>
      </div>
      <div class="terminal">
        <div class="terminal-bar" aria-hidden="true"><i></i><i></i><i></i><span class="mono">~/code</span></div>
        <pre class="mono"><span class="prompt">$</span> gh repo fork Emikael/e6code --clone
<span class="ok">✓</span> <span class="dim">Cloned into ./e6code</span>
<span class="prompt">$</span> cd e6code &amp;&amp; vp i
<span class="ok">✓</span> <span class="dim">Dependencies installed</span>
<span class="prompt">$</span> vp run dev
<span class="dim">server + web running ·</span> <span class="accent">your fork, your rules</span></pre>
      </div>
    </div>
  </section>

  <!-- ── Final CTA ──────────────────────────────────────────────── -->
  <section id="download" class="cta" aria-labelledby="cta-title">
    <div class="cta-bg" aria-hidden="true"><div class="hero-grid"></div></div>
    <div class="container cta-inner reveal">
      <h2 id="cta-title">Your agents deserve<br />better than a terminal.</h2>
      <p>Install it, plug in the harness you already pay for, and get back to the work only you can do.</p>
      <div class="hero-actions">
        {downloads.map((download) => (
          <a class:list={["btn btn-primary btn-lg dl", `dl--${download.os}`]} href={download.href} data-asset={download.asset}>
            <span>{download.label}</span>
          </a>
        ))}
        <a class="btn btn-ghost btn-lg" href="/download">Windows · Linux · other</a>
      </div>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease } from "../lib/releases";

  const byId = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;

  /** Points the desktop download buttons at the latest release's files. */
  async function initDownload() {
    const buttons = Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-asset]"));
    try {
      const assets = (await fetchLatestRelease()).assets ?? [];
      for (const button of buttons) {
        const match = assets.find((asset) => asset.name.endsWith(button.dataset.asset!));
        if (match) button.href = match.browser_download_url;
      }
    } catch {
      // The buttons already link to the releases page.
    }
  }

  /** Wires a tab group: click or arrow keys select, `onSelect` renders the panel. */
  function tabs(buttons: HTMLElement[], onSelect: (button: HTMLElement) => void) {
    const select = (button: HTMLElement, focus = false) => {
      for (const b of buttons) {
        const on = b === button;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
      }
      if (focus) button.focus();
      onSelect(button);
    };
    const steps: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
    for (const button of buttons) {
      button.addEventListener("click", () => select(button));
      button.addEventListener("keydown", (event) => {
        const step = steps[event.key];
        if (!step) return;
        event.preventDefault();
        const next = buttons[(buttons.indexOf(button) + step + buttons.length) % buttons.length];
        if (next) select(next, true);
      });
    }
    return select;
  }

  function initInstall(platform: string | undefined) {
    const code = byId("install-command");
    const copy = byId("install-copy");
    if (!code || !copy) return;
    const buttons = Array.from(document.querySelectorAll<HTMLElement>("[data-install]"));
    const select = tabs(buttons, (button) => {
      code.textContent = button.dataset.install === "windows" ? code.dataset.windows! : code.dataset.unix!;
    });
    if (platform === "win" && buttons[1]) select(buttons[1]);

    const label = copy.querySelector(".copy-label")!;
    let reset: number | undefined;
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "Copied";
      } catch {
        label.textContent = "Select it";
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => (label.textContent = "Copy"), 1600);
    });
  }

  function initRemote() {
    const visual = byId("remote-visual");
    const command = byId("remote-command");
    const detail = byId("remote-detail");
    if (!visual || !command || !detail) return;
    tabs(Array.from(visual.querySelectorAll<HTMLElement>("button[data-mode]")), (button) => {
      command.textContent = button.dataset.command ?? "";
      detail.textContent = button.dataset.detail ?? "";
    });
  }

  function initCompare() {
    const compare = byId("compare");
    const range = compare?.querySelector<HTMLInputElement>(".compare-range");
    if (!compare || !range) return;
    range.addEventListener("input", () => compare.style.setProperty("--pos", `${range.value}%`));
  }

  // Set by the inline head script.
  const platform = document.documentElement.dataset.platform;
  if (platform === "mac" || platform === "win" || platform === "linux") void initDownload();
  initInstall(platform);
  initRemote();
  initCompare();
</script>

