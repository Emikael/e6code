---
import { getImage } from "astro:assets";
import threadDark from "../assets/app-thread-dark.webp";
import threadLight from "../assets/app-thread-light.webp";
import settingsDark from "../assets/app-settings-dark.webp";
import Layout from "../layouts/Layout.astro";
import {
  ANDROID_PLAY_STORE_URL,
  GITHUB_REPOSITORY_URL,
  INSTALL_COMMANDS,
  IOS_APP_STORE_URL,
} from "../lib/site";

// Screenshots are 2x captures of the desktop app at 1440x900.
const shotWidths = [960, 1440, 2160];
const [threadDarkSet, threadLightSet, settingsSet] = await Promise.all(
  [threadDark, threadLight, settingsDark].map((src) =>
    getImage({ src, widths: shotWidths, format: "webp", quality: 86 }),
  ),
);

// Sign-in steps mirror the README and docs/user/providers-*.md.
const agents = [
  { name: "Claude Code", command: "claude auth login" },
  { name: "Codex", command: "codex login" },
  { name: "Cursor", command: "agent login" },
  { name: "Grok Build", command: "grok login" },
  { name: "OpenCode", command: "opencode auth login" },
  { name: "Antigravity", command: "Settings → Install" },
];

// Mirrors the subagents in the hero screenshot. Each state carries a word.
const subagents = [
  { name: "Dashboard share button", meta: "sonnet-4-5 · medium · 9.7K tok · 5 tools", state: "Working", tone: "live" },
  { name: "Share link API", meta: "opus-4-5 · high · 3 files · +247 −6", state: "Needs approval", tone: "wait" },
  { name: "Share link tests", meta: "asks: which share link expiry should the tests cover?", state: "Needs your answer", tone: "ask" },
  { name: "Share link docs", meta: "sonnet-4-5 · 2 files · +76 −3 · 26s", state: "Done", tone: "done" },
];

const turns = [
  { n: 1, title: "Scaffold settings panel", add: 212, del: 0 },
  { n: 2, title: "Wire panel to contracts", add: 64, del: 18 },
  { n: 3, title: "Fix stale label on reconnect", add: 9, del: 5 },
  { n: 4, title: "Add focused tests", add: 88, del: 2 },
];

const hosts = ["GitHub", "GitLab", "Bitbucket", "Azure DevOps", "Forgejo", "Gitea"];

const routes = [
  { prompt: "thanks, that fixed it!", verdict: "Answered locally", detail: "Small talk never wakes your provider." },
  { prompt: "what does this regex match?", verdict: "Trimmed context", detail: "Goes to your agent with less attached." },
  { prompt: "migrate the auth middleware to Effect", verdict: "Full turn", detail: "Exactly as if routing were off." },
];

const commands = [
  { label: "New thread", keys: ["⌘", "⇧", "O"] },
  { label: "Search threads", keys: ["⌘", "K"] },
  { label: "Toggle run details", keys: ["⌘", "I"] },
];

const connections = [
  {
    key: "lan",
    label: "Same network",
    command: "e6 serve --host <private-ip>",
    detail: "Turn on Network access in Settings → Connections, then scan a one-time pairing link from your phone.",
  },
  {
    key: "tailscale",
    label: "Tailscale",
    command: "e6 serve --tailscale-serve",
    detail: "HTTPS across your tailnet. Both devices join the tailnet, then pair once.",
  },
  {
    key: "connect",
    label: "E6 Connect",
    command: "e6 connect",
    detail: "No port forwarding. Sign in on the host and on your other device, then choose the environment.",
  },
];
---

<Layout>
  <!-- ── Hero ──────────────────────────────────────────────────── -->
  <section class="hero container">
    <p class="hero-signal" data-rise>
      <span class="signal-dot" aria-hidden="true"></span>
      6 agents · 3 surfaces · 0 tokens resold
    </p>
    <h1 class="hero-title" data-rise style="--d:60ms">
      Every coding agent.<br /><span class="hero-title-quiet">One calm control room.</span>
    </h1>
    <p class="hero-sub" data-rise style="--d:120ms">
      E6 Code runs Claude Code, Codex, Cursor, Grok Build, OpenCode, and Antigravity side by side,
      on your machine, with the subscriptions you already pay for. Drive it from the desktop, a
      browser, or your phone.
    </p>
    <div class="hero-actions" data-rise style="--d:180ms">
      <a id="download-btn" href="https://github.com/Emikael/e6code/releases" class="btn btn-primary btn-lg">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 15V3" /><path d="m7 10 5 5 5-5" /><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /></svg>
        <span id="download-label">Download for macOS</span>
      </a>
      <a class="btn btn-ghost btn-lg" href="/download">All platforms</a>
    </div>

    <div class="install" data-rise style="--d:240ms">
      <div class="seg" role="tablist" aria-label="Install command">
        <button type="button" role="tab" class="seg-btn" data-install="unix" aria-selected="true">macOS · Linux</button>
        <button type="button" role="tab" class="seg-btn" data-install="windows" aria-selected="false" tabindex="-1">Windows</button>
      </div>
      <div class="install-line">
        <span class="prompt" aria-hidden="true">$</span>
        <code id="install-command" data-unix={INSTALL_COMMANDS.unix} data-windows={INSTALL_COMMANDS.windows}>{INSTALL_COMMANDS.unix}</code>
        <button type="button" class="copy-btn" id="install-copy" aria-label="Copy install command">
          <span class="copy-label" aria-live="polite">Copy</span>
        </button>
      </div>
    </div>

    <p class="hero-mobile-line" data-rise style="--d:300ms">
      Also on <a href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">iOS</a> and <a href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">Android</a>. Free and MIT licensed.
    </p>
  </section>

  <!-- ── Product shot ───────────────────────────────────────────── -->
  <section class="shot-wrap container" aria-label="The E6 Code app">
    <figure class="shot">
      <picture>
        <source media="(prefers-color-scheme: light)" srcset={threadLightSet.srcSet.attribute} sizes="(max-width: 1240px) calc(100vw - 60px), 1180px" />
        <img
          src={threadDarkSet.src}
          srcset={threadDarkSet.srcSet.attribute}
          sizes="(max-width: 1240px) calc(100vw - 60px), 1180px"
          alt="An E6 Code thread in which Claude splits the work across four subagents: one working, one waiting for approval, one asking a question and one done, beside the run details panel with context, changes and the live subagent"
          width={threadDark.width}
          height={threadDark.height}
          loading="eager"
          decoding="async"
        />
      </picture>
      <figcaption>
        <span>One thread, four subagents. Every state says its name.</span>
        <span class="mono">E6 Code · macOS</span>
      </figcaption>
    </figure>
  </section>

  <!-- ── Harnesses ──────────────────────────────────────────────── -->
  <section class="harnesses container" aria-labelledby="harness-title">
    <h2 id="harness-title">Sign in where you already do. E6 Code drives the CLI you have.</h2>
    <ul>
      {agents.map((agent) => (
        <li>
          <span class="harness-name">{agent.name}</span>
          <span class="mono">{agent.command}</span>
        </li>
      ))}
    </ul>
  </section>

  <!-- ── Features ───────────────────────────────────────────────── -->
  <section id="features" class="sec container" aria-labelledby="features-title">
    <div class="section-head">
      <p class="eyebrow">What you get</p>
      <h2 id="features-title">The agent's work is the brightest thing on screen.</h2>
      <p>Plans, subagents, diffs, and approvals sit in calm panels. The chrome stays out of the way.</p>
    </div>

    <div class="bento">
      <article class="tile card wide">
        <div class="card-head">
          <h3>Watch the run, not just the reply</h3>
          <p>Split work across subagents and see each one's state, model, cost, and files. Destructive commands need a one-second hold to allow.</p>
        </div>
        <ul class="list">
          {subagents.map((agent) => (
            <li class="list-row">
              <span class="list-main">
                <span class="list-title">{agent.name}</span>
                <span class="mono list-meta">{agent.meta}</span>
              </span>
              <span class:list={["state", `state--${agent.tone}`]}>
                <span class="state-dot" aria-hidden="true"></span>{agent.state}
              </span>
            </li>
          ))}
        </ul>
      </article>

      <article class="tile card">
        <div class="card-head">
          <h3>Every turn is a checkpoint</h3>
          <p>A hidden git ref after each turn. Diff exactly what changed, or rewind when it wanders.</p>
        </div>
        <ol class="turns">
          {turns.map((turn) => (
            <li>
              <span class="mono turn-n">{turn.n}</span>
              <span class="turn-title">{turn.title}</span>
              <span class="mono add">+{turn.add}</span>
              <span class="mono del">−{turn.del}</span>
            </li>
          ))}
        </ol>
      </article>

      <article class="tile card">
        <div class="card-head">
          <h3>Every thread can be a PR</h3>
          <p>Commit, push, and open the pull request without leaving the thread.</p>
        </div>
        <ul class="chips">
          {hosts.map((host) => <li class="mono">{host}</li>)}
        </ul>
        <div class="pr-row">
          <span class="list-main">
            <span class="list-title">Add share links to dashboards</span>
            <span class="mono list-meta">feat/share-links · 4 files · <span class="add">+323</span> <span class="del">−9</span></span>
          </span>
          <span class="pr-btn">Open PR</span>
        </div>
      </article>

      <article class="tile card">
        <div class="card-head">
          <h3>Jev routing, if you want it</h3>
          <p>Opt in and each turn is classified first. Small talk is answered locally, simple questions go out with trimmed context, and real work gets the whole thread.</p>
        </div>
        <ul class="routes">
          {routes.map((route) => (
            <li>
              <span class="mono">› {route.prompt}</span>
              <strong>{route.verdict}</strong>
              <span class="route-detail">{route.detail}</span>
            </li>
          ))}
        </ul>
      </article>

      <article class="tile card">
        <div class="card-head">
          <h3>Keyboard first, touch equal</h3>
          <p>Every action is in the command palette, with keybindings you can change.</p>
        </div>
        <div class="palette" aria-hidden="true">
          <div class="palette-search">Search commands…</div>
          {commands.map((command, index) => (
            <div class:list={["palette-row", index === 0 && "is-active"]}>
              <span>{command.label}</span>
              <span class="keys">{command.keys.map((key) => <kbd>{key}</kbd>)}</span>
            </div>
          ))}
        </div>
      </article>
    </div>
  </section>

  <!-- ── Remote ─────────────────────────────────────────────────── -->
  <section id="remote" class="sec container split" aria-labelledby="remote-title">
    <div class="section-head">
      <p class="eyebrow">Remote ready</p>
      <h2 id="remote-title">Your agents keep working. You don't have to sit there.</h2>
      <p>
        The server lives on the machine with your code. Phones, browsers, and other desktops connect
        over your network, your tailnet, or E6 Connect. With two or more machines connected, new
        threads can balance across them.
      </p>
      <p class="store-line">
        <a class="btn btn-ghost" href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">iOS app</a>
        <a class="btn btn-ghost" href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">Android app</a>
      </p>
    </div>
    <div class="tile remote" id="remote-visual">
      <div class="seg seg--bar" role="tablist" aria-label="Connection mode">
        {connections.map((mode, index) => (
          <button
            type="button"
            role="tab"
            class="seg-btn"
            data-mode={mode.key}
            data-command={mode.command}
            data-detail={mode.detail}
            aria-selected={index === 0 ? "true" : "false"}
            tabindex={index === 0 ? "0" : "-1"}
          >
            {mode.label}
          </button>
        ))}
      </div>
      <div class="remote-body">
        <div class="well mono"><span class="prompt" aria-hidden="true">$</span> <span id="remote-command">{connections[0]!.command}</span></div>
        <p id="remote-detail" aria-live="polite">{connections[0]!.detail}</p>
        <ul class="devices">
          <li><span class="state-dot state-dot--ok" aria-hidden="true"></span>workstation · connected</li>
          <li>iPhone</li>
          <li>any browser</li>
          <li>second Mac</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ── Make it yours ──────────────────────────────────────────── -->
  <section class="sec container split split--media" aria-labelledby="yours-title">
    <figure class="shot shot--small">
      <img
        src={settingsSet.src}
        srcset={settingsSet.srcSet.attribute}
        sizes="(max-width: 960px) calc(100vw - 60px), 680px"
        alt="E6 Code Appearance settings with the Match system, Porcelain, and Slate themes and the Iris, Cobalt, Rose, and Graphite accents"
        width={settingsDark.width}
        height={settingsDark.height}
        loading="lazy"
        decoding="async"
      />
    </figure>
    <div class="section-head">
      <p class="eyebrow">Make it yours</p>
      <h2 id="yours-title">Porcelain by day, Slate by night.</h2>
      <p>Two quiet themes and four accents. One accent, one meaning: it marks the next action and a working agent, nothing else.</p>
      <ul class="accents">
        <li><span class="swatch swatch--iris" aria-hidden="true"></span>Iris</li>
        <li><span class="swatch swatch--cobalt" aria-hidden="true"></span>Cobalt</li>
        <li><span class="swatch swatch--rose" aria-hidden="true"></span>Rose</li>
        <li><span class="swatch swatch--graphite" aria-hidden="true"></span>Graphite</li>
      </ul>
    </div>
  </section>

  <!-- ── Open source ────────────────────────────────────────────── -->
  <section id="open" class="sec container" aria-labelledby="open-title">
    <div class="tile open">
      <div class="section-head">
        <p class="eyebrow">Open at the core</p>
        <h2 id="open-title">Don't like a decision? Fork it.</h2>
        <p>
          E6 Code is MIT licensed and built in the open. It doesn't resell tokens or proxy your keys,
          so your plan, limits, and credentials stay yours.
        </p>
        <p class="store-line">
          <a class="btn btn-primary" href={`${GITHUB_REPOSITORY_URL}/fork`} target="_blank" rel="noopener noreferrer">Fork on GitHub</a>
          <a class="btn btn-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">Browse source</a>
        </p>
      </div>
      <pre class="well mono terminal"><span class="prompt">$</span> gh repo fork Emikael/e6code --clone
<span class="ok">✓</span> <span class="dim">Cloned into ./e6code</span>
<span class="prompt">$</span> cd e6code &amp;&amp; vp i
<span class="ok">✓</span> <span class="dim">Dependencies installed</span>
<span class="prompt">$</span> vp run dev
<span class="dim">server + web running ·</span> <span class="accent">your fork, your rules</span></pre>
    </div>
  </section>

  <!-- ── Final CTA ──────────────────────────────────────────────── -->
  <section id="download" class="cta container" aria-labelledby="cta-title">
    <h2 id="cta-title">Your agents deserve<br /><span class="hero-title-quiet">better than a terminal.</span></h2>
    <p>Install it, plug in the harness you already pay for, and get back to the work only you can do.</p>
    <div class="hero-actions">
      <a id="cta-download-btn" class="btn btn-primary btn-lg" href="https://github.com/Emikael/e6code/releases">
        <span id="cta-download-label">Download for macOS</span>
      </a>
      <a class="btn btn-ghost btn-lg" href="/download">Windows · Linux · other</a>
    </div>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    if (platform.os === "win") {
      return assets.find((a) => a.name.endsWith("-x64.exe"))?.browser_download_url ?? null;
    }
    if (platform.os === "mac") {
      return assets.find((a) => a.name.endsWith("-arm64.dmg"))?.browser_download_url ?? null;
    }
    if (platform.os === "linux") {
      return assets.find((a) => a.name.endsWith("-x86_64.AppImage"))?.browser_download_url ?? null;
    }
    return null;
  }

  const byId = <T extends HTMLElement = HTMLElement>(id: string) =>
    document.getElementById(id) as T | null;

  async function initDownload(platform: Platform) {
    const buttons = [byId<HTMLAnchorElement>("download-btn"), byId<HTMLAnchorElement>("cta-download-btn")];
    for (const label of [byId("download-label"), byId("cta-download-label")]) {
      if (label) label.textContent = platform.label;
    }
    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (!url) return;
      for (const btn of buttons) if (btn) btn.href = url;
    } catch {
      for (const btn of buttons) if (btn) btn.href = RELEASES_URL;
    }
  }

  /** Wires a tab group: click or arrow keys select, `onSelect` renders the panel. */
  function tabs(buttons: HTMLElement[], onSelect: (button: HTMLElement) => void) {
    const select = (button: HTMLElement, focus = false) => {
      for (const b of buttons) {
        const on = b === button;
        b.setAttribute("aria-selected", String(on));
        b.tabIndex = on ? 0 : -1;
      }
      if (focus) button.focus();
      onSelect(button);
    };
    const steps: Record<string, number> = { ArrowDown: 1, ArrowRight: 1, ArrowUp: -1, ArrowLeft: -1 };
    for (const button of buttons) {
      button.addEventListener("click", () => select(button));
      button.addEventListener("keydown", (event) => {
        const step = steps[event.key];
        if (!step) return;
        event.preventDefault();
        const next = buttons[(buttons.indexOf(button) + step + buttons.length) % buttons.length];
        if (next) select(next, true);
      });
    }
    return select;
  }

  function initInstall(platform: Platform | null) {
    const code = byId("install-command");
    const copy = byId("install-copy");
    if (!code || !copy) return;
    const buttons = Array.from(document.querySelectorAll<HTMLElement>("[data-install]"));
    const select = tabs(buttons, (button) => {
      code.textContent = button.dataset.install === "windows" ? code.dataset.windows! : code.dataset.unix!;
    });
    if (platform?.os === "win" && buttons[1]) select(buttons[1]);

    const label = copy.querySelector(".copy-label")!;
    let reset: number | undefined;
    copy.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        label.textContent = "Copied";
      } catch {
        label.textContent = "Select it";
      }
      window.clearTimeout(reset);
      reset = window.setTimeout(() => (label.textContent = "Copy"), 1600);
    });
  }

  function initRemote() {
    const visual = byId("remote-visual");
    const command = byId("remote-command");
    const detail = byId("remote-detail");
    if (!visual || !command || !detail) return;
    tabs(Array.from(visual.querySelectorAll<HTMLElement>("button[data-mode]")), (button) => {
      command.textContent = button.dataset.command ?? "";
      detail.textContent = button.dataset.detail ?? "";
    });
  }

  const platform = detectPlatform();
  if (platform) {
    document.documentElement.dataset.platform = platform.os;
    void initDownload(platform);
  }
  initInstall(platform);
  initRemote();
</script>

<style>
  .mono {
    font-family: var(--font-mono);
  }

  .add {
    color: var(--diff-add);
  }

  .del {
    color: var(--diff-del);
  }

  .prompt {
    color: var(--fg-muted);
  }

  /* ── Hero ─────────────────────────────────────────────────── */
  .hero {
    padding-top: 88px;
    padding-bottom: 48px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 20px;
  }

  .hero-signal {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--accent-dim);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 16px;
  }

  .signal-dot {
    width: 6px;
    height: 6px;
    border-radius: 999px;
    background: var(--primary);
    box-shadow: 0 0 0 3px var(--accent-dim);
  }

  .hero-title {
    max-width: 860px;
    font-size: clamp(40px, 6vw, 68px);
    line-height: 1.04;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .hero-title-quiet {
    color: var(--fg-muted);
  }

  .hero-sub {
    max-width: 620px;
    font-size: 17px;
    line-height: 27px;
    color: var(--fg-muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    margin-top: 4px;
  }

  .install {
    margin-top: 8px;
    width: 100%;
    max-width: 560px;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-card);
    text-align: left;
    overflow: hidden;
  }

  .seg {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 6px;
    border-bottom: 1px solid var(--border);
  }

  .seg--bar {
    padding: 8px;
    background: var(--bg-elev);
  }

  .seg-btn {
    height: 28px;
    padding: 0 12px;
    border-radius: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--fg-muted);
  }

  .seg-btn:hover {
    color: var(--fg);
  }

  .seg-btn[aria-selected="true"] {
    background: var(--surface-well);
    color: var(--fg);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }

  .install-line {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    font-family: var(--font-mono);
    font-size: 13px;
    line-height: 20px;
  }

  .install-line code {
    flex: 1 1 auto;
    min-width: 0;
    overflow-x: auto;
    white-space: nowrap;
    font-family: inherit;
  }

  .copy-btn {
    height: 28px;
    padding: 0 10px;
    border-radius: 6px;
    border: 1px solid var(--border-strong);
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 500;
  }

  .copy-btn:hover {
    background: var(--bg-elev);
  }

  .hero-mobile-line {
    font-size: 13px;
    color: var(--fg-muted);
  }

  .hero-mobile-line a {
