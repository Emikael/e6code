---
import { getImage, Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import desktopScreenshot from "../assets/app-thread-dark.webp";
import geistLatinUrl from "../assets/fonts/geist-latin.woff2?url";
import "../styles/fonts.css";
import { ANDROID_PLAY_STORE_URL, GITHUB_REPOSITORY_URL, IOS_APP_STORE_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  /** Keeps the page out of search: no canonical link and no og:url. */
  noindex?: boolean;
}

const {
  title = "E6 Code",
  description = "E6 Code is the open-source control room for coding agents. Run Claude Code, Codex, Cursor, Grok, OpenCode, and Antigravity with the subscriptions you already have, from desktop, web, or your phone.",
  pageClass,
  noindex = false,
} = Astro.props;

// Social preview card. Link unfurlers (Instagram, iMessage, X, Slack) want a
// 1200x630 jpg or png at an absolute URL. Built from the hero screenshot so it
// stays in sync with the homepage.
const socialImage = await getImage({
  src: desktopScreenshot,
  width: 1200,
  height: 630,
  fit: "cover",
  position: "top",
  format: "jpg",
  quality: 90,
});
const socialImageUrl = new URL(socialImage.src, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="E6 Code" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="An E6 Code thread with four subagents and the run details panel." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link
      rel="preload"
      href={geistLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <nav class="nav">
        <div class="nav-inner">
          <a href="/" class="nav-brand" aria-label="E6 Code home">
            <Image
              src={appIcon}
              alt=""
              width={22}
              height={22}
              densities={[1, 2, 3]}
              format="webp"
              quality={90}
              loading="eager"
              decoding="async"
            />
            <span class="nav-brand-name">E6 Code</span>
          </a>
          <div class="nav-right">
            <a class="nav-link nav-link--section" href="/#features">Features</a>
            <a class="nav-link nav-link--section" href="/#remote">Remote</a>
            <a class="nav-link nav-link--section" href="/#open">Open source</a>
            <a class="nav-link" href="/download">Download</a>
            <a
              class="nav-stars"
              href={GITHUB_REPOSITORY_URL}
              target="_blank"
              rel="noopener noreferrer"
              aria-label="E6 Code on GitHub"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12a11.5 11.5 0 007.86 10.93c.58.1.79-.25.79-.56v-2c-3.2.69-3.88-1.37-3.88-1.37-.52-1.33-1.27-1.69-1.27-1.69-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.02 1.76 2.68 1.25 3.33.96.1-.75.4-1.25.72-1.54-2.55-.29-5.24-1.27-5.24-5.67 0-1.25.45-2.28 1.18-3.08-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.15 1.18a10.96 10.96 0 015.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.57.23 2.73.11 3.02.74.8 1.18 1.83 1.18 3.08 0 4.41-2.7 5.38-5.27 5.66.41.36.78 1.06.78 2.13v3.16c0 .31.21.67.8.56A11.5 11.5 0 0023.5 12C23.5 5.65 18.35.5 12 .5z"/>
              </svg>
              <span>GitHub</span>
            </a>
          </div>
        </div>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer-inner">
          <div class="footer-brand">
            <Image
              src={appIcon}
              alt=""
              width={20}
              height={20}
              densities={[1, 2, 3]}
              format="webp"
              quality={90}
              loading="lazy"
              decoding="async"
            />
            <span>&copy; {new Date().getFullYear()} Emikael Silveira · MIT licensed</span>
          </div>
          <div class="footer-links">
            <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
            <a href="/download">Download</a>
            <a href={IOS_APP_STORE_URL} target="_blank" rel="noopener noreferrer">iOS app</a>
            <a href={ANDROID_PLAY_STORE_URL} target="_blank" rel="noopener noreferrer">Android app</a>
            <a href="/terms-of-service">Terms</a>
            <a href="/privacy-policy">Privacy</a>
            <a href="/security-policy">Security</a>
          </div>
        </div>
      </footer>
    </div>

    <script>
      const nav = document.querySelector(".nav");
      const onScroll = () => {
        if (!nav) return;
        if (window.scrollY > 12) nav.classList.add("is-scrolled");
        else nav.classList.remove("is-scrolled");
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    </script>
  </body>
</html>

<style is:global>
  /* Graphite, the app's neutral accent, at contrast 120: STOCK_ACCENT_PALETTES.graphite
     in packages/shared/src/themePalettes.ts over the Slate (dark, the default)
     and Porcelain (light) surfaces, with text roles mixed 20% toward black or
     white and borders 5% toward the foreground. Porcelain follows a light system
     appearance. The short names are the ones the marketing pages already use:
     --bg background, --bg-elev surface-raised, --bg-card card, --fg foreground,
     --fg-muted and --fg-dim muted-foreground, --fg-faint placeholder,
     --border-strong input, --accent primary-text, --accent-dim primary-surface,
     --ok success-foreground, --warn warning-foreground. */
  :root {
    --bg: #1a1d23;
    --bg-elev: #13151a;
    --bg-card: #22252c;
    --surface-well: #0f1114;
    --fg: #f0f1f5;
    --fg-muted: #b1b5c0;
    --fg-dim: #b1b5c0;
    --fg-faint: #a3a8b3;
    --border: #ffffff1c;
    --border-strong: #ffffff2c;
    /* The next action. --accent is the accent as text. */
    --primary: #d4d7de;
    --primary-hover: #e6e8ec;
    --primary-fg: #14161b;
    --primary-edge: #c0c4cc;
    --ring: #d4d7de;
    --accent: #e6e8ec;
    --accent-dim: #d4d7de1f;
    --ok: #5eead4;
    --ok-dot: #2dd4bf;
    --warn: #fcd34d;
    --warn-dot: #fbbf24;
    --warn-dim: #fbbf2429;
    --diff-add: #5eead4;
    --diff-del: #fca5a5;
    --shadow-shot: 0 22px 44px -16px #000000b3, 0 4px 12px -2px #0000006b;
    --font-sans: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-mono: "Geist Mono", ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 16px;
    color-scheme: dark;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --bg: #ffffff;
      --bg-elev: #f8f9fb;
      --bg-card: #ffffff;
      --surface-well: #eceef2;
      --fg: #0c0d11;
      --fg-muted: #41454f;
      --fg-dim: #41454f;
      --fg-faint: #4e525d;
      --border: #d9dbe0;
      --border-strong: #c4c8cf;
      --primary: #2a2d35;
      --primary-hover: #14161b;
      --primary-fg: #ffffff;
      --primary-edge: #2a2d35;
      --ring: #2a2d35;
      --accent: #2a2d35;
      --accent-dim: #2a2d3514;
      --ok: #096b5f;
      --ok-dot: #0f9f8c;
      --warn: #92400e;
      --warn-dot: #d97706;
      --warn-dim: #d9770614;
      --diff-add: #0b5e54;
      --diff-del: #a1170d;
      --shadow-shot: 0 16px 36px -14px #14161b29, 0 2px 6px -1px #14161b0d;
      color-scheme: light;
    }
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-dim);
    font-weight: 500;
  }

  .display {
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 500;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 8px;
    transition: background 0.15s ease-out, border-color 0.15s ease-out, color 0.15s ease-out;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--primary);
    color: var(--primary-fg);
    box-shadow: inset 0 0 0 1px var(--primary-edge);
  }

  .btn-primary:hover {
    background: var(--primary-hover);
  }

  .btn-ghost {
    color: var(--fg);
    border: 1px solid var(--border-strong);
    background: var(--bg-card);
  }

  .btn-ghost:hover {
    background: var(--bg-elev);
  }

  .btn-lg {
    padding: 14px 22px;
    font-size: 15px;
    border-radius: 10px;
  }

  .tile {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    overflow: hidden;
  }

  :focus-visible {
    outline: 2px solid var(--ring);
    /* The ring is the primary fill's color, so it needs a gap to read as a ring. */
    outline-offset: 2px;
    border-radius: 4px;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Page-load sequence: [data-rise] plays once with delay --d. */
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  [data-rise] {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-rise] { animation: none; }
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .nav.is-scrolled {
    border-bottom-color: var(--border);
  }

  .nav-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 12px 32px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--fg);
    transition: color 0.2s ease;
  }

  .nav-brand-name {
    font-size: 16px;
    font-weight: 650;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .nav-right {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .nav-link {
    padding: 0 10px;
    color: var(--fg-muted);
    font-size: 13px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.18s ease;
  }

  .nav-link:hover {
    color: var(--fg);
  }

  .nav-stars {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 32px;
    padding: 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: 8px;
    background: var(--bg-card);
    color: var(--fg);
    font-size: 13px;
    letter-spacing: -0.01em;
    white-space: nowrap;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
  }

  .nav-stars:hover {
    background: var(--bg-elev);
  }

  .nav-stars svg {
    flex-shrink: 0;
  }

  .nav-brand img {
    border-radius: 5px;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    padding: 40px 0 32px;
  }

  .footer-inner {
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    color: var(--fg-dim);
  }

  .footer-brand img {
    width: 20px;
    height: 20px;
    border-radius: 4px;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 20px;
  }

  .footer-links a {
    font-size: 13px;
    color: var(--fg-dim);
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: var(--fg);
  }

  @media (max-width: 820px) {
    .nav-inner,
    .footer-inner {
      padding-left: 20px;
      padding-right: 20px;
    }

    .legal-document-page .nav {
      display: none;
    }

    .footer {
      padding-bottom: max(32px, env(safe-area-inset-bottom));
    }

    .footer-inner {
      align-items: flex-start;
      flex-direction: column;
      gap: 28px;
    }

    .footer-links {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      width: 100%;
      gap: 14px 20px;
      justify-content: initial;
    }
  }

  @media (max-width: 720px) {
    .nav-link--section {
      display: none;
    }
  }

  @media (max-width: 420px) {
    .nav-inner {
      gap: 12px;
    }

    .nav-stars {
      height: 34px;
      gap: 6px;
      padding: 0 12px;
      font-size: 12px;
    }
  }
</style>
