---
import { getImage, Image } from "astro:assets";
import appIcon from "../assets/icon.webp";
import socialCard from "../assets/social-card.png";
import geistLatinUrl from "../assets/fonts/geist-latin.woff2?url";
import "../styles/fonts.css";
import { shipped, showHowItWorks } from "../lib/shipped";
import { ANDROID_PLAY_STORE_URL, GITHUB_REPOSITORY_URL, IOS_APP_STORE_URL, SITE_DESCRIPTION } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
  /** Keeps the page out of search: no canonical link and no og:url. */
  noindex?: boolean;
}

const {
  title = "E6 Code: run coding agents in parallel, open source",
  description = SITE_DESCRIPTION,
  pageClass,
  noindex = false,
} = Astro.props;

// Social preview card. Link unfurlers (Instagram, iMessage, X, Slack) want a
// 1200x630 jpg or png at an absolute URL. src/assets/social-card.png is the
// landing headline over the top of src/assets/app-thread-dark.webp; recompose
// it when either changes. It never names ADHD, so sharing a link discloses
// nothing about the person sharing it.
const socialImage = await getImage({ src: socialCard, width: 1200, height: 630, format: "jpg", quality: 90 });
const socialImageUrl = new URL(socialImage.src, Astro.site);
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);

const isHome = Astro.url.pathname === "/";
// In the order of the landing page's sections.
const navLinks = [
  { label: "Remote", href: "/#remote" },
  { label: "Open source", href: "/#open" },
  ...(showHowItWorks ? [{ label: "How it works", href: "/#how" }] : []),
  ...(shipped.calmByDesign ? [{ label: "Calm by design", href: "/#calm" }] : []),
  { label: "GitHub", href: GITHUB_REPOSITORY_URL },
];
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <slot name="head" />
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonicalUrl} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="E6 Code" />
    {!noindex && <meta property="og:url" content={canonicalUrl} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="E6 Code. Run your agents in parallel. Know which one needs you. Above the desktop app running a thread with four subagents." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <link
      rel="preload"
      href={geistLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <header class="site-header">
        <nav class="nav" aria-label="Site" data-nav>
          <a href={isHome ? "#top" : "/"} class="nav-brand">
            <Image
              src={appIcon}
              alt=""
              width={26}
              height={26}
              densities={[1, 2, 3]}
              format="webp"
              quality={90}
              loading="eager"
              decoding="async"
            />
            <span class="nav-brand-name">E6 Code</span>
          </a>
          <span class="nav-grow"></span>
          <span class="nav-links" id="nav-links">
            {navLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            <a href="/download" data-menu-only>Download</a>
          </span>
          <a href="/download" class="nav-download">Download</a>
          <button type="button" class="nav-menu" aria-label="Menu" aria-expanded="false" aria-controls="nav-links">
            <svg class="nav-menu-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
            <svg class="nav-menu-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"></path></svg>
          </button>
        </nav>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <span class="footer-name">E6 Code · MIT licensed</span>
        <a href="/download">Download</a>
        <a href={GITHUB_REPOSITORY_URL}>GitHub</a>
        <a href={IOS_APP_STORE_URL}>iOS</a>
        <a href={ANDROID_PLAY_STORE_URL}>Android</a>
        <a href="/security-policy">Security</a>
        <a href="/privacy-policy">Privacy</a>
        <a href="/terms-of-service">Terms</a>
      </footer>
    </div>

    <script>
      // Under 700px the section links fold into the Menu button. The links come
      // before the button in the DOM (that is their order on a wide screen) but
      // show below it when open, so opening moves focus to the first link and
      // closing returns it to the button.
      const nav = document.querySelector<HTMLElement>("[data-nav]");
      const menu = nav?.querySelector<HTMLButtonElement>(".nav-menu");
      const links = nav?.querySelector<HTMLElement>("#nav-links");
      const setOpen = (open: boolean, focus: boolean) => {
        nav?.toggleAttribute("data-open", open);
        menu?.setAttribute("aria-expanded", String(open));
        if (!focus) return;
        if (open) links?.querySelector("a")?.focus();
        else menu?.focus();
      };
      menu?.addEventListener("click", () => setOpen(menu.getAttribute("aria-expanded") !== "true", true));
      links?.addEventListener("click", (event) => {
        if ((event.target as Element).closest("a")) setOpen(false, false);
      });
      nav?.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && nav.hasAttribute("data-open")) setOpen(false, true);
      });
    </script>
  </body>
</html>

<style is:global>
  /* Graphite, the app's neutral accent, at contrast 120: STOCK_ACCENT_PALETTES.graphite
     in packages/shared/src/themePalettes.ts over the Slate (dark, the default)
     and Porcelain (light) surfaces, with text roles mixed 20% toward black or
     white and borders 5% toward the foreground. Porcelain follows a light system
     appearance. The short names are the ones the marketing pages already use:
     --bg background, --bg-elev surface-raised, --bg-card card, --fg foreground,
     --fg-muted and --fg-dim muted-foreground, --fg-faint placeholder,
     --border-strong input, --accent primary-text, --accent-dim primary-surface,
     --hover accent (the hover fill), --ok success-foreground, --warn
     warning-foreground. */
  :root {
    --bg: #1a1d23;
    --bg-elev: #13151a;
    --bg-card: #22252c;
    --surface-well: #0f1114;
    --fg: #f0f1f5;
    --fg-muted: #b1b5c0;
    --fg-dim: #b1b5c0;
    --fg-faint: #a3a8b3;
    --border: #ffffff1c;
    --border-strong: #ffffff2c;
    /* The next action. --accent is the accent as text. */
    --primary: #d4d7de;
    --primary-hover: #e6e8ec;
    --primary-fg: #14161b;
    --primary-edge: #c0c4cc;
    --ring: #d4d7de;
    --accent: #e6e8ec;
    --accent-dim: #d4d7de1f;
    --hover: #ffffff0f;
    --ok: #5eead4;
    --ok-dot: #2dd4bf;
    --warn: #fcd34d;
    --warn-dot: #fbbf24;
    --warn-dim: #fbbf2429;
    --diff-add: #5eead4;
    --diff-del: #fca5a5;
    --shadow-shot: 0 22px 44px -16px #000000b3, 0 4px 12px -2px #0000006b;
    --font-sans: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-mono: "Geist Mono", ui-monospace, "SF Mono", SFMono-Regular, Menlo, Consolas, monospace;
    --radius: 12px;
    --radius-sm: 8px;
    --radius-lg: 16px;
    color-scheme: dark;
  }

  @media (prefers-color-scheme: light) {
    :root {
      --bg: #ffffff;
      --bg-elev: #f8f9fb;
      --bg-card: #ffffff;
      --surface-well: #eceef2;
      --fg: #0c0d11;
      --fg-muted: #41454f;
      --fg-dim: #41454f;
      --fg-faint: #4e525d;
      --border: #d9dbe0;
      --border-strong: #c4c8cf;
      --primary: #2a2d35;
      --primary-hover: #14161b;
      --primary-fg: #ffffff;
      --primary-edge: #2a2d35;
      --ring: #2a2d35;
      --accent: #2a2d35;
      --accent-dim: #2a2d3514;
      --hover: #eef0f4;
      --ok: #096b5f;
      --ok-dot: #0f9f8c;
      --warn: #92400e;
      --warn-dot: #d97706;
      --warn-dim: #d9770614;
      --diff-add: #0b5e54;
      --diff-del: #a1170d;
      --shadow-shot: 0 16px 36px -14px #14161b29, 0 2px 6px -1px #14161b0d;
      color-scheme: light;
    }
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    html {
      scroll-behavior: smooth;
    }
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    min-height: 100vh;
    overflow-x: hidden;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  button {
    font-family: inherit;
    cursor: pointer;
    border: 0;
    background: none;
    color: inherit;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  .eyebrow {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-dim);
    font-weight: 500;
  }

  .display {
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.05;
  }

  .container {
    width: 100%;
    max-width: 1240px;
    margin: 0 auto;
    padding: 0 32px;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-weight: 500;
    font-size: 14px;
    padding: 10px 18px;
    border-radius: 8px;
    transition: background 0.15s ease-out, border-color 0.15s ease-out, color 0.15s ease-out;
    white-space: nowrap;
  }

  .btn-primary {
    background: var(--primary);
    color: var(--primary-fg);
    box-shadow: inset 0 0 0 1px var(--primary-edge);
  }

  .btn-primary:hover {
    background: var(--primary-hover);
  }

  .btn-ghost {
    color: var(--fg);
    border: 1px solid var(--border-strong);
    background: var(--bg-card);
  }

  .btn-ghost:hover {
    background: var(--bg-elev);
  }

  .btn-lg {
    padding: 14px 22px;
    font-size: 15px;
    border-radius: 10px;
  }

  .tile {
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    overflow: hidden;
  }

  :focus-visible {
    outline: 2px solid var(--ring);
    /* The ring is the primary fill's color, so it needs a gap to read as a ring. */
    outline-offset: 2px;
  }

  /* Plain text links get soft ring corners; buttons and other classed links
     keep their own radius. */
  a:not([class]):focus-visible {
    border-radius: 4px;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Page-load sequence: [data-rise] plays once with delay --d. */
  @keyframes rise {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: none; }
  }
  [data-rise] {
    animation: rise 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) both;
    animation-delay: var(--d, 0ms);
  }
  @media (prefers-reduced-motion: reduce) {
    [data-rise] { animation: none; }
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    overflow-x: clip;
  }

  .nav,
  .footer {
    width: 100%;
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
  }

  .nav {
    min-height: 64px;
    gap: 24px;
  }

  .nav-brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    font: 600 16px/20px var(--font-sans);
  }

  .nav-brand img {
    width: 26px;
    height: 26px;
    border-radius: 7px;
    box-shadow: 0 0 0 1px var(--border-strong);
  }

  .nav-grow {
    flex: 1 1 0;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .nav-links a {
    padding: 6px 0;
    font: 500 14px/20px var(--font-sans);
    color: var(--fg-muted);
  }

  .nav-links a:hover {
    color: var(--fg);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .nav-download,
  .nav-menu {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 32px;
    border-radius: 8px;
    border: 1px solid transparent;
    color: var(--fg);
  }

  .nav-download {
    padding: 0 12px;
    background: var(--bg-card);
    border-color: var(--fg-muted);
    font: 500 13px/18px var(--font-sans);
    white-space: nowrap;
  }

  .nav-download:hover,
  .nav-menu:hover {
    background: var(--hover);
  }

  .nav-menu {
    display: none;
    width: 32px;
  }

  .nav-menu svg {
    color: var(--fg-muted);
  }

  .nav-menu[aria-expanded="true"] .nav-menu-open,
  .nav-menu:not([aria-expanded="true"]) .nav-menu-close,
  .nav[data-nav] .nav-links [data-menu-only] {
    display: none;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    padding-top: 28px;
    padding-bottom: 28px;
    gap: 20px;
    border-top: 1px solid var(--border);
    font: 400 14px/22px var(--font-sans);
  }

  .footer-name {
    flex: 1 1 200px;
    min-width: 0;
    color: var(--fg-muted);
  }

  .footer a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--fg-muted);
    text-underline-offset: 3px;
  }

  @media (max-width: 820px) {
    .legal-document-page .site-header {
      display: none;
    }

    .footer {
      padding-bottom: max(28px, env(safe-area-inset-bottom));
    }
  }

  @media (max-width: 700px) {
    /* The closed bar stays on one line down to the narrowest phones. */
    .nav {
      gap: 12px;
      padding: 0 8px 0 16px;
    }

    .nav:not([data-open]) {
      flex-wrap: nowrap;
    }

    .nav-brand {
      min-width: 0;
    }

    .nav-links {
      display: none;
    }

    .nav-menu {
      display: inline-flex;
    }

    .nav-download,
    .nav-menu {
      min-height: 44px;
    }

    .nav-menu {
      width: 44px;
    }

    .nav-brand {
      min-height: 44px;
    }

    /* The open menu (board 21 shows only the closed button): the links in the
       page's order, one full-width 48px row each, under the bar. It closes on
       the button, on Escape and on a link. */
    .nav[data-open] {
      border-bottom: 1px solid var(--border);
    }

    .nav[data-open] .nav-links {
      display: flex;
      order: 1;
      flex: 1 0 100%;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      margin: 0 -8px 0 -16px;
      padding-bottom: 8px;
    }

    .nav[data-open] .nav-links a {
      display: flex;
      align-items: center;
      min-height: 48px;
      padding: 0 16px;
      border-top: 1px solid var(--border);
      font: 500 16px/24px var(--font-sans);
      color: var(--fg);
    }

    .nav[data-open] .nav-links a:hover {
      background: var(--hover);
      text-decoration: none;
    }

    .nav[data-open] .nav-links a:focus-visible {
      outline-offset: -2px;
      border-radius: 0;
    }
  }

  /* Phone (board 21): a 56px bar with the name and Menu; Download moves into
     the menu as its last row. */
  @media (max-width: 520px) {
    .nav {
      min-height: 56px;
    }

    .nav-brand {
      gap: 8px;
    }

    .nav-brand img {
      width: 24px;
      height: 24px;
      border-radius: 6px;
    }

    .nav-download {
      display: none;
    }

    .nav[data-open] .nav-links [data-menu-only] {
      display: flex;
    }
  }

  @media (max-width: 480px) {
    .footer {
      padding-left: 16px;
      padding-right: 16px;
    }
  }
</style>
