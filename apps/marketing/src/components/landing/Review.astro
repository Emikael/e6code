---
const hosts = "GitHub, GitLab, Bitbucket, Azure DevOps, Forgejo and Gitea";
---

<section class="band">
  <div class="wrap grid2">
    <div class="stack review">
      <p class="eyebrow">Review and recover</p>
      <h2 class="h2">Every turn is a checkpoint.</h2>
      <p class="copy measure">A hidden git ref after each turn. Diff it, or rewind when it wanders.</p>
      <div class="stack point">
        <h3 class="h3">Every thread can be a pull request</h3>
        <p class="copy measure">Works with {hosts}.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .review {
    gap: 20px;
  }

  .point {
    gap: 4px;
  }

  .measure {
    max-width: 48ch;
  }
</style>
